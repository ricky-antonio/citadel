# ─── Mapbox ──────────────────────────────────────────────────────────────────
# Required for client-side map rendering (Mapbox GL JS).
# Get from: account.mapbox.com → Tokens → Create a token
# IMPORTANT: Restrict this token to your production domain in the Mapbox dashboard
#            before deploying. Without domain restriction anyone can use it.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Server-only. Used for streaming AI chat and daily city briefings.
# Get from: console.anthropic.com → API Keys → Create key
# Model in use: claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
# Use a separate Supabase project for local dev, preview, and production.
#
# NEXT_PUBLIC_ vars are safe to expose (anon key, public URL)
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose client-side
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Ticketmaster ────────────────────────────────────────────────────────────
# Server-only. Used for events data.
# Get from: developer.ticketmaster.com → Get Your API Key → Consumer Key
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# ─── Eventbrite ──────────────────────────────────────────────────────────────
# Server-only. Used for supplementary events data.
# Get from: eventbrite.com/platform → Create an app → Private Token
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# ─── Transit APIs ────────────────────────────────────────────────────────────
# All server-only. Each key is city-specific.

# New York MTA — GTFS-RT real-time subway feed
# Get from: api.mta.info → Register
MTA_API_KEY=your_mta_api_key_here

# San Francisco 511 SF Bay
# Get from: 511.org/open-data/token → Request a token
SF_511_API_KEY=your_sf511_api_key_here

# Chicago CTA Train Tracker
# Get from: transitchicago.com/developers/traintracker.aspx → Register
CTA_API_KEY=your_cta_api_key_here

# Washington DC WMATA
# Get from: developer.wmata.com → Get a Key → Default Tier → Primary Key
WMATA_API_KEY=your_wmata_api_key_here

# ─── Vercel KV (rate limiting) ───────────────────────────────────────────────
# Required for @upstash/ratelimit in production.
# Get from: Vercel dashboard → Storage → Create KV → connect to project
# All four vars are provided by Vercel automatically when KV is linked.
# For local dev, rate limiting fails open if these are absent (allowed).
KV_URL=your_kv_url_here
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_rest_api_read_only_token_here

# ─── Sentry ──────────────────────────────────────────────────────────────────
# Production error monitoring. Run `npx @sentry/wizard@latest -i nextjs` to set up.
# The wizard creates this in .env.local automatically.
# Get from: sentry.io → your project → Settings → Client Keys (DSN)
SENTRY_DSN=your_sentry_dsn_here

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used for Mapbox token domain restriction verification and absolute URL construction.
# Local: http://localhost:3000
# Production: https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
